<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>ClarionDbg</AssemblyName>
    <RootNamespace>ClarionDbg.Cli</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The RTL emulator (Library State) uses C# 8 switch expressions and C# 9 `or` patterns; net48
         defaults to 7.3. These are compile-time-only features, safe on the .NET Framework runtime.
         Pinned rather than `latest` so a toolchain bump can't silently pull in a language feature that
         needs newer runtime support than net48 has. -->
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClarionDbg.Core\ClarionDbg.Core.csproj" />
    <!-- EXPERIMENT: pure-managed x86 disassembler for the disassembly view (no native deps). -->
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>

</Project>
