<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone Clarion Debugger IDE addin (extracted from ClarionAssistant, task 74c792f8).
    Loads in the Clarion IDE independently of the full Clarion Assistant addin. Drives the
    sibling ClarionDbg.exe engine (launched as a child process) over its @JSON protocol.

    ClarionRoot defaults to C:\Clarion12; override per Clarion version on the command line:
        msbuild ClarionDebugger.Addin.csproj /p:ClarionRoot=D:\Clarion11.1EE
    (a ClarionDebugger.Addin.csproj.user / Directory.Build.props.user override also works).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>ClarionDebugger</AssemblyName>
    <RootNamespace>ClarionDebugger</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!--
      THE released version, and the only thing AddinFinder compares against the git tag.
      Three parts, no build number — see CheckAddinVersion below. AssemblyVersion is pinned to it
      deliberately so the build number never reaches an assembly-binding identity.
    -->
    <Version>1.1.1</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ClarionRoot Condition="'$(ClarionRoot)' == ''">C:\Clarion12</ClarionRoot>
  </PropertyGroup>

  <!-- Clarion IDE (SharpDevelop) host assemblies — compile-time only, shipped by the IDE. -->
  <ItemGroup>
    <Reference Include="ICSharpCode.Core">
      <HintPath>$(ClarionRoot)\bin\ICSharpCode.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICSharpCode.SharpDevelop">
      <HintPath>$(ClarionRoot)\bin\ICSharpCode.SharpDevelop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICSharpCode.TextEditor">
      <HintPath>$(ClarionRoot)\bin\ICSharpCode.TextEditor.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- .NET Framework assemblies not referenced by default in SDK-style net48 projects. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- WebView2 (debugger panel host). PackageReference copies the runtime loader + native bits. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
  </ItemGroup>

  <!--
    The debugger panel HTML is deployed alongside the DLL. ClarionDebugger.addin is deliberately
    NOT copied here — StampAddinManifest below emits the output copy, with the pad title stamped.
  -->
  <ItemGroup>
    <None Include="ClarionDebugger.addin" />
    <None Include="Terminal\debugger.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateClarionRoot" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ClarionRoot)\bin\ICSharpCode.Core.dll')"
           Text="Missing Clarion IDE assemblies at $(ClarionRoot)\bin. Set ClarionRoot to your Clarion install (e.g. /p:ClarionRoot=C:\Clarion12)." />
  </Target>

  <!--
    Version guard — keeps <Version> above and the addin manifest's <Identity version> equal.

    Why this matters: AddinFinder (msarson/ClarionAddinFinder) decides "Update available" by
    comparing the manifest's <Identity version> on disk against the GitHub release tag minus its
    leading 'v', component-wise (InstalledAddinStore.CompareDotted). If they differ by any
    component the IDE shows "Update available" permanently — and reinstalling cannot clear it,
    because the freshly-installed manifest keeps reasserting the same wrong number. v1.1.0 shipped
    exactly that way: the installer carried a manifest still declaring 1.0.0.

    Two deliberate choices, both learned the hard way on the sibling ClarionAssistant repo:

      * NOT gated on Configuration == Release. We ship Debug builds (build-installer.ps1 passes
        /p:Configuration=Debug), so a Release-only guard — which is what the reference
        implementation does — would never once run.

      * The .iss needs no arm here: it holds no version literal at all any more.
        build-installer.ps1 passes it via /DMyAppVersion from this same $(Version), and a bare
        ISCC run stops at an #error. Do NOT re-add a hardcoded "#define MyAppVersion" to the .iss
        thinking this target covers it — it does not, and that copy is the one that has drifted
        before.

    XmlPeek rather than a regex: the manifest's own quotes and angle brackets would have to be
    expanded into MSBuild property syntax for a Regex property function, which breaks on this file.
  -->
  <!--
    Build number = git commit count. Chosen over an auto-incrementing counter file because it
    stores no state, never rewrites a tracked file, and maps back to an exact commit.

    It is NOT a safe version component in its own right, and must not be treated as one: the count
    rises along a single linear history, but a feature branch can carry a higher count than main,
    and a squash-merge can put main on a LOWER count than a dev build you already produced. So the
    number can go backwards between builds. That is harmless only because it never reaches
    <Identity version>, which AddinFinder compares forward-only — the worst it can do is show a
    caption that looks like it went back a build. Do not promote it into a compared version. (The counter-file approach on the sibling ClarionAssistant repo rewrites its props
    file mid-build, which is what forced its version guard to be scoped to
    BuildingInsideVisualStudio.)

    The build number goes into FileVersion / InformationalVersion ONLY — never into $(Version),
    $(AssemblyVersion), or the manifest's <Identity version>. AddinFinder compares Identity
    against the release tag, so a build number there would put every install back on the
    permanent "Update available" that v1.1.1 exists to fix.

    Degrades safely: no git, no repo, or a build from an exported tarball all yield build 0 and a
    warning rather than a failed build.
  -->
  <Target Name="ComputeBuildNumber" BeforeTargets="GetAssemblyAttributes;CheckAddinVersion;StampAddinManifest">
    <Exec Command="git rev-list --count HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>

    <PropertyGroup>
      <BuildNumber Condition="'$(_GitExitCode)' == '0' and '$(_GitCommitCount)' != ''">$(_GitCommitCount.Trim())</BuildNumber>
      <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
      <FullVersion>$(Version).$(BuildNumber)</FullVersion>
      <FileVersion>$(FullVersion)</FileVersion>
      <InformationalVersion>$(FullVersion)</InformationalVersion>
    </PropertyGroup>

    <Warning Condition="'$(BuildNumber)' == '0'"
             Text="ComputeBuildNumber: could not read a git commit count (git missing, or not a repo). Falling back to build 0 — this build's displayed version will be $(FullVersion)." />
  </Target>

  <!--
    Emit the output manifest with the pad title stamped to the full version, so the docked pad
    caption reads "CA Debugger v1.1.1.847". PadDescriptor.Title is read-only at runtime, so the
    caption has to be baked into the manifest at build time.

    Only the pad's title attribute is rewritten. <Identity version> is copied through untouched,
    which is why the checked-in ClarionDebugger.addin stays the authoritative, standalone-valid
    source of truth and CheckAddinVersion still guards it directly. Do NOT switch this to a
    template-with-tokens scheme: that would leave the repo without a valid checked-in manifest
    and put a generated file on the path AddinFinder reads.
  -->
  <!--
    Deliberately NOT incremental. An Inputs/Outputs pair here can only name files, and the value
    being stamped ($(BuildNumber), a git commit count) is not one — so the target would skip
    whenever only the commit count had moved and happily ship a caption a build behind the DLL.
    That was observed: FileVersion 1.1.1.132 against a caption reading v1.1.1.131. A copy plus one
    XmlPoke is far too cheap to be worth re-introducing that risk.
  -->
  <Target Name="StampAddinManifest"
          AfterTargets="CheckAddinVersion"
          BeforeTargets="Build">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\ClarionDebugger.addin"
          DestinationFiles="$(IntermediateOutputPath)ClarionDebugger.addin" />
    <XmlPoke XmlInputPath="$(IntermediateOutputPath)ClarionDebugger.addin"
             Query="/AddIn/Path[@name='/SharpDevelop/Workbench/Pads']/Pad/@title"
             Value="CA Debugger v$(FullVersion)" />
    <Message Importance="normal" Text="StampAddinManifest: pad caption -> 'CA Debugger v$(FullVersion)' (Identity version stays $(Version))" />
  </Target>

  <Target Name="CopyStampedAddinManifest" AfterTargets="Build" DependsOnTargets="StampAddinManifest">
    <Copy SourceFiles="$(IntermediateOutputPath)ClarionDebugger.addin"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CheckAddinVersion" BeforeTargets="Build">
    <PropertyGroup>
      <_AddinManifest>$(MSBuildProjectDirectory)\ClarionDebugger.addin</_AddinManifest>
    </PropertyGroup>

    <Error Condition="!Exists('$(_AddinManifest)')"
           Text="CheckAddinVersion: addin manifest not found at $(_AddinManifest)." />

    <XmlPeek XmlInputPath="$(_AddinManifest)" Query="/AddIn/Manifest/Identity/@version">
      <Output TaskParameter="Result" PropertyName="_AddinIdentityVersion" />
    </XmlPeek>

    <Error Condition="'$(_AddinIdentityVersion)' == ''"
           Text="CheckAddinVersion: could not read /AddIn/Manifest/Identity/@version from $(_AddinManifest). The manifest shape changed — fix this target, do not delete it." />

    <Error Condition="'$(_AddinIdentityVersion)' != '$(Version)'"
           Text="CheckAddinVersion: version drift. ClarionDebugger.Addin.csproj &lt;Version&gt; is '$(Version)' but ClarionDebugger.addin &lt;Identity version&gt; is '$(_AddinIdentityVersion)'. These must be identical — AddinFinder compares the manifest version against the release tag and will show 'Update available' forever if they disagree. Update both, and tag the release v$(Version)." />
  </Target>

</Project>
