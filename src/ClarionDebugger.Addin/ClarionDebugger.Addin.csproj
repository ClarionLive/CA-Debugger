<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone Clarion Debugger IDE addin (extracted from ClarionAssistant, task 74c792f8).
    Loads in the Clarion IDE independently of the full Clarion Assistant addin. Drives the
    sibling ClarionDbg.exe engine (launched as a child process) over its @JSON protocol.

    ClarionRoot defaults to C:\Clarion12; override per Clarion version on the command line:
        msbuild ClarionDebugger.Addin.csproj /p:ClarionRoot=D:\Clarion11.1EE
    (a ClarionDebugger.Addin.csproj.user / Directory.Build.props.user override also works).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>ClarionDebugger</AssemblyName>
    <RootNamespace>ClarionDebugger</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.1</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ClarionRoot Condition="'$(ClarionRoot)' == ''">C:\Clarion12</ClarionRoot>
  </PropertyGroup>

  <!-- Clarion IDE (SharpDevelop) host assemblies — compile-time only, shipped by the IDE. -->
  <ItemGroup>
    <Reference Include="ICSharpCode.Core">
      <HintPath>$(ClarionRoot)\bin\ICSharpCode.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICSharpCode.SharpDevelop">
      <HintPath>$(ClarionRoot)\bin\ICSharpCode.SharpDevelop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICSharpCode.TextEditor">
      <HintPath>$(ClarionRoot)\bin\ICSharpCode.TextEditor.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- .NET Framework assemblies not referenced by default in SDK-style net48 projects. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- WebView2 (debugger panel host). PackageReference copies the runtime loader + native bits. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
  </ItemGroup>

  <!-- Addin manifest + the debugger panel HTML are deployed alongside the DLL. -->
  <ItemGroup>
    <None Include="ClarionDebugger.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Terminal\debugger.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateClarionRoot" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ClarionRoot)\bin\ICSharpCode.Core.dll')"
           Text="Missing Clarion IDE assemblies at $(ClarionRoot)\bin. Set ClarionRoot to your Clarion install (e.g. /p:ClarionRoot=C:\Clarion12)." />
  </Target>

  <!--
    Version guard — keeps <Version> above and the addin manifest's <Identity version> equal.

    Why this matters: AddinFinder (msarson/ClarionAddinFinder) decides "Update available" by
    comparing the manifest's <Identity version> on disk against the GitHub release tag minus its
    leading 'v', component-wise (InstalledAddinStore.CompareDotted). If they differ by any
    component the IDE shows "Update available" permanently — and reinstalling cannot clear it,
    because the freshly-installed manifest keeps reasserting the same wrong number. v1.1.0 shipped
    exactly that way: the installer carried a manifest still declaring 1.0.0.

    Two deliberate choices, both learned the hard way on the sibling ClarionAssistant repo:

      * NOT gated on Configuration == Release. We ship Debug builds (build-installer.ps1 passes
        /p:Configuration=Debug), so a Release-only guard — which is what the reference
        implementation does — would never once run.

      * The .iss needs no arm here: it holds no version literal at all any more.
        build-installer.ps1 passes it via /DMyAppVersion from this same $(Version), and a bare
        ISCC run stops at an #error. Do NOT re-add a hardcoded "#define MyAppVersion" to the .iss
        thinking this target covers it — it does not, and that copy is the one that has drifted
        before.

    XmlPeek rather than a regex: the manifest's own quotes and angle brackets would have to be
    expanded into MSBuild property syntax for a Regex property function, which breaks on this file.
  -->
  <Target Name="CheckAddinVersion" BeforeTargets="Build">
    <PropertyGroup>
      <_AddinManifest>$(MSBuildProjectDirectory)\ClarionDebugger.addin</_AddinManifest>
    </PropertyGroup>

    <Error Condition="!Exists('$(_AddinManifest)')"
           Text="CheckAddinVersion: addin manifest not found at $(_AddinManifest)." />

    <XmlPeek XmlInputPath="$(_AddinManifest)" Query="/AddIn/Manifest/Identity/@version">
      <Output TaskParameter="Result" PropertyName="_AddinIdentityVersion" />
    </XmlPeek>

    <Error Condition="'$(_AddinIdentityVersion)' == ''"
           Text="CheckAddinVersion: could not read /AddIn/Manifest/Identity/@version from $(_AddinManifest). The manifest shape changed — fix this target, do not delete it." />

    <Error Condition="'$(_AddinIdentityVersion)' != '$(Version)'"
           Text="CheckAddinVersion: version drift. ClarionDebugger.Addin.csproj &lt;Version&gt; is '$(Version)' but ClarionDebugger.addin &lt;Identity version&gt; is '$(_AddinIdentityVersion)'. These must be identical — AddinFinder compares the manifest version against the release tag and will show 'Update available' forever if they disagree. Update both, and tag the release v$(Version)." />
  </Target>

</Project>
